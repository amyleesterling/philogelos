rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /conversations/{userId}/messages/{messageId} {
      allow read, write: if true;
    }
    match /subscribers/{phone} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /answers/{answerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['q', 'text', 'ts'])
        && request.resource.data.q is string
        && request.resource.data.q.size() > 0
        && request.resource.data.q.size() <= 300
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.ts is int;
      allow update, delete: if false;
    }
  }
}
